public class BatchApexExample implements database.batchable<sObject>
{
    public static <contact> start(database.batchableContext sbc)
    {
        list<contact> updateContact = [SELECT Id,firstname,lastname FROM contact WHERE phone =null];
        return updateContact;
        
    }
    public static void execute(database.batchableContext ebc,list<contact> updateContact)
    {
        for(contact con:updateContact)
        {
            con.phone ='8765432109';
        }
        update updateContact;
        
    }
    public static void finish(database.batchableContext fbc)
    {
        
    }

}

//Execution :- 
BatchApexPhone bap = new BatchApexPhone();
    database.executeBatch(bap);




