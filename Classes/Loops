public class LoopsDemo
{
        public static void DoWhile()
        {
            integer i = 0 ;
            do
            {
                system.debug('Hello world'+i);
                i++;
            }
            while(i > 3);
            
        }
    
    
    public static void TaskWhile()
    {
        integer i = 10;
        do
        {
           system.debug(' 3 X'+ i+'='+(3*i));
            i--;
        }
        while( i >= 1);
       
    }
    
    public static void table()
    {
        integer i =1;
        while(i<=10){
            system.debug('249 X'+ i+'='+ (249*i));
            i++;
        }
    }
    
  
}
