//NO DML follow n ACCOUNT TRIGGER 

public class AccountTriggerHandler
{
    public static void BeforeDelete(list<Account>NewList)
    {
        set<id> accids = new set<id>();
        for(Account Acc : NewList)
        {
            accids.add(acc.id);
        }
        list<contact>conlist =[SELECT id FROM contact WHERE accountid IN : accids];
        for(Account acc1 : NewList)
        {
            integer i =conlist.size();
            if(i >0)
            {
                Acc1.adderror('can not delete the account since it has '+i+ 'contacts');
            }
        }
    }
    
    public static void BeforeInsertBeforeUpdate(list<account>NewList)
    {
        for(account acc: NewList)
        {
            if(acc.industry == 'Education' && acc.Type =='prospect' && acc.AnnualRevenue == null)
            {
                acc.AnnualRevenue.adderror('kindly enter the Annual Revenue');
            }
        }
    }
    
    public static void AfterUpdate(list<account>NewList ,Map<Id ,Account>OldMap)
    {
        set<id>accidsphone =new set<id>();
        set<id> accids =new set<id>(); //collection account ids
        list<case> calist =new list<case>();
        for(account acc : NewList)
        {
            if(acc.AnnualRevenue != null)
            {
                accids.add(acc.id);
            }
            if(acc.Rating == 'cold')
            {
                case ca = new case();
                ca.Status ='New';
                ca.Origin ='Web';
                ca.AccountId = acc.Id;
                calist.add(ca);
            }
            Account accOld = OldMap.get(acc.Id);
            if(acc.Phone != accold.phone)//the phone is change 
            {
                accidsphone.add(acc.id); 
            }
            
        }
        insert calist;
        
        
        list<opportunity> accRelatedOpp = [SELECT Id,Amount FROM opportunity WHERE AccountId IN: accids];
        for(opportunity opp :accRelatedOpp)
        {
            opp.Amount = opp.Account.AnnualRevenue;
        }
        update accRelatedOpp;
        
        list<contact> accRelatedCon = [SELECT Id,phone,account.phone FROM contact WHERE accountid IN:accidsphone];
        for(contact con :accRelatedCon)
        {
            con.phone = con.account.phone;
        }
        update accRelatedCon;
        
    }
        
        
        public static void AfterInsert(list<account> NewList)
       
        {
            for(account acc : NewList)
            {
                if(acc.Rating == 'Hot')
                {
                    contact con = new contact();
                    con.LastName = 'Rel Con';
                    con.AccountId = acc.Id;
                    insert con;
                }
            }
        }
        
    }

//NO DML follow in CONTACT TRIGGER


public class ContactTriggerHandler
{
    
    public static void BeforeInsertBeforeUpdate(list<contact>NewList)
    {
        set<id>conaccids =new set<id>();
        for(contact con: NewList)
        {  
            conaccids.add(con.AccountId);
            //Birthday date on today
            if(con.Birthdate > date.today())
            {
                con.Birthdate.adderror('Invalid Birthdate');
                
            }
            
            //Gender values for contact
            if(con.Salutation == 'mr.')
            {
                con.Description = 'male';
            }
            else if(con.Salutation == 'ms.'|| con.Salutation =='mrs.')
            {
                con.Description ='Female';
            }
            
            //mailling country
            if(con.MailingCountry != null && con.MailingState == null)
            {
                con.MailingState.adderror('Kindly select the state');
            }
        }
            
        //not more than 3 contact to single account 
        account relAcc =[SELECT Id FROM Account WHERE id IN:conaccids];
        list<contact>conlist =[SELECT Id FROM contact WHERE AccountId =:relAcc.Id];
        for(contact Checkcon : NewList)
        {
            if(conlist.size()>=3)
            {
                Checkcon.adderror('contact limit Excceded ,not more than 3 contact for a single Account');
            }
            
        }
        
    }
    
    public void BeforeDelete(list<contact>OldList)
    {
        
        for(contact con : OldList)
        {
            if(con.AccountId != null)
            {
                con.AccountId.adderror('can not delete the contact since it is related to an account');
            }
        }
        
    }
    public void AfterInsertAfterUpdate(list<contact>NewList)
    {
        //Phone is null then create Task
        for(contact con : NewList)
        {
            if(con.Phone == null)
            {
                task ta = new task();
                ta.Subject ='get the contact details';
                ta.WhoId =con.Id;
                ta.ActivityDate =date.today().addDays(4);
                ta.ownerId =con.ownerId;
                insert ta;
            }
        }
    }
    
}
