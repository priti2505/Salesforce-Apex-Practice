//TRIGGER CODE 

trigger Accountrigger on Account (before insert, before delete , before update , after insert,after update, after delete,after undelete)
{  
    if(trigger.isBefore )
    {
        if(trigger.isDelete)
        {
            AccountTriggerHandler.BeforeDelete(trigger.new); 
        }
        if(trigger.isInsert || trigger.IsUpdate)
        { 
            AccountTriggerHandler.BeforeInsertBeforeUpdate(trigger.new);
            
        }
        if(trigger.isAfter && trigger.isUpdate)
        {
            AccountTriggerHandler.AfterUpdate(trigger.new , trigger.oldMap);
            
        }
        if(trigger.isAfter && trigger.isInsert)
        {
            AccountTriggerHandler.AfterInsert(trigger.new);
        }
    }
}
